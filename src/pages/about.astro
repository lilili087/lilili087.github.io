---
import BaseLayout from '../layouts/BaseLayout.astro';

const about = {
  personality: ['细致认真', '善于沟通', '创新思维', '目标导向', '乐观开朗'],
  hobbies: ['阅读', '摄影', '徒步', '手冲咖啡', '看展'],
  dailyLife: '工作日专注于产品设计和开发，周末喜欢探索城市里的咖啡馆和展览，偶尔去郊外徒步放松。保持学习和成长是我的生活常态。',
  values: ['用户至上', '持续学习', '开放协作', '追求卓越'],
};
---

<BaseLayout title="关于我 - Xinxin Li">
  <div class="container">
    <section class="section">
      <h2 class="section-title">关于我</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem;">
        <div>
          <h3 style="font-weight: 600; margin-bottom: 1rem; color: var(--color-text); font-size: 1.2rem;">性格特点</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem;">
            {about.personality.map((item) => (
              <span class="tag" style="padding: 0.5rem 1rem; font-size: 0.95rem;">{item}</span>
            ))}
          </div>

          <h3 style="font-weight: 600; margin-bottom: 1rem; color: var(--color-text); font-size: 1.2rem;">兴趣爱好</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem;">
            {about.hobbies.map((item) => (
              <span class="tag" style="background: #f0f9ff; padding: 0.5rem 1rem; font-size: 0.95rem;">{item}</span>
            ))}
          </div>

          <h3 style="font-weight: 600; margin-bottom: 1rem; color: var(--color-text); font-size: 1.2rem;">价值观</h3>
          <ul style="list-style: none; color: var(--color-text-light); line-height: 2;">
            {about.values.map((item) => (
              <li style="margin-bottom: 0.5rem;">• {item}</li>
            ))}
          </ul>
        </div>

        <div>
          <h3 style="font-weight: 600; margin-bottom: 1rem; color: var(--color-text); font-size: 1.2rem;">日常生活</h3>
          <div style="background: linear-gradient(135deg, #faf9f8 0%, #fff5f5 100%); padding: 2rem; border-radius: var(--radius); line-height: 1.8; color: var(--color-text-light);">
            {about.dailyLife}
          </div>

          <div style="margin-top: 2rem; padding: 1.5rem; background: var(--color-primary-light); border-radius: var(--radius);">
            <h4 style="font-weight: 600; margin-bottom: 0.75rem; color: var(--color-text);">工作风格</h4>
            <p style="color: var(--color-text-light); line-height: 1.7;">
              注重细节但不失大局观，善于在复杂问题中找到最优解。
              相信团队协作的力量，也享受独立思考和深度工作的时光。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">教育背景</h2>
      <div style="display: flex; align-items: center; gap: 1.5rem;">
        <div style="width: 60px; height: 60px; background: var(--color-primary-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🎓</div>
        <div>
          <h3 style="font-weight: 600; color: var(--color-text);">北京邮电大学</h3>
          <p style="color: var(--color-text-light);">学士学位 · 相关专业</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
